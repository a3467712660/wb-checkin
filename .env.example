# 编排参数（非敏感，可提交）
# 镜像地址由 install.sh 自动写入，形如 ghcr.io/<你的GitHub用户名>/wb-checkin:latest
WB_IMAGE=ghcr.io/change-me/wb-checkin:latest

# 每天执行时刻（逗号分隔，24 小时制，容器内按 Asia/Shanghai 计算）
RUN_TIMES=07:00,12:00,23:30

# 容器启动时是否立刻先跑一轮：1=是，0=否
RUN_ON_START=0

# 单轮最长秒数，超时强制结束（防止网络卡死堵住后面所有时间点）
RUN_TIMEOUT=3600

# 传给上游脚本的额外参数，留空 = 上游默认全跑
# 例：--tasks checkin,travel,chat_5   （只想跑这几项）
TASK_ARGS=

# 推送策略：always 每次都推 / fail 仅异常时推 / 0 关闭
# 推送通道（PushPlus / Bark / 企业微信等）的密钥写在 secrets.env 里
WORKBUDDY_NOTIFY=always
