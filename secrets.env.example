# ⚠️ 真实文件名是 secrets.env：权限 600
# ⚠️ 不要提交 git、不要贴聊天窗口。refreshToken 等于账号密码，能无限续期。
# ⚠️ 由 ./set-token.sh 自动写入；手改时注意整行只保留一对引号。
#
# 凭据格式：手机号:AT:RT
#   · 单个账号写一行即可
#   · 多个账号用 @ 分隔写在**同一行**——不要真的换行，
#     换行符在 env_file 里会被当成两个变量，第二个直接丢
#     例：WORKBUDDY_REFRESH_TOKEN='13800000000:eyJ...:eyJ...@13900000000:eyJ...:eyJ...'
#   · AT 可以留空写成 手机号::RT

WORKBUDDY_REFRESH_TOKEN=


# ============ 推送通道（填哪个用哪个，全留空 = 不推送） ============
# 值里有空格或特殊字符时用单引号包起来，例如 BARK_URL='https://api.day.app/xxx'

# 微信 - PushPlus（最省事，扫码就有 token）：https://www.pushplus.plus
# PUSHPLUS_TOKEN=

# 微信 - Server酱（免费每天 5 条）：https://sct.ftqq.com
# SERVERCHAN_SENDKEY=

# 微信 - WxPusher：https://wxpusher.zjiecode.com
# WXPUSHER_APP_TOKEN=AT_xxxxxxxx
# WXPUSHER_UID=UID_xxxxxxxx

# iOS - Bark
# BARK_URL=https://api.day.app/xxxxxxxxxxxx

# 企业微信群机器人（填完整 URL 或只填 key）
# WECOM_WEBHOOK=

# 钉钉群机器人（安全设置选「加签」时必须同时填 SECRET）
# DINGTALK_WEBHOOK=
# DINGTALK_SECRET=


# ============ 推送策略（非敏感，想改就取消注释） ============
# always 每轮都推 / fail 仅异常时推 / 0 完全关闭
# WORKBUDDY_NOTIFY=fail


# ============ 任务范围（可选，默认全跑） ============
# 白名单：只跑列出的子任务。可用值：checkin travel lottery redeem gift makeup
#         badges blindbox buddy_info desktop chat_5
# ⚠️ 若只留签到类、没有任何「使用类」任务，成长中心「今日活跃」热力墙不会点亮。
#    想两者兼得：WORKBUDDY_TASKS=checkin,travel,chat_5
# WORKBUDDY_TASKS=

# 黑名单：跳过指定子任务
# WORKBUDDY_SKIP_TASKS=

# 每轮最多补签几张（默认 1，最大 10）
# WORKBUDDY_MAKEUP_MAX_PER_RUN=1
